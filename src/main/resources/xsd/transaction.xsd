<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://bank.com/transaction"
           xmlns="http://bank.com/transaction"
           elementFormDefault="qualified">

    <xs:element name="Transaction" type="TransactionType"/>

    <xs:complexType name="TransactionType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="fromAccount" type="xs:string"/>
            <xs:element name="toAccount" type="xs:string"/>
            <xs:element name="amount" type="xs:decimal"/>
            <xs:element name="type" type="TransactionTypeEnum"/>
            <xs:element name="createdAt" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="TransactionTypeEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="DEBIT"/>
            <xs:enumeration value="CREDIT"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:element name="TransactionResponse" type="TransactionResponseType"/>

    <xs:complexType name="TransactionResponseType">
        <xs:sequence>
            <xs:element name="id" type="xs:string"/>
            <xs:element name="status" type="TransactionStatusEnum"/>
            <xs:element name="createdAt" type="xs:dateTime"/>
        </xs:sequence>
    </xs:complexType>

    <xs:simpleType name="TransactionStatusEnum">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PENDING"/>
            <xs:enumeration value="FAILED"/>
            <xs:enumeration value="COMPLETED"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>